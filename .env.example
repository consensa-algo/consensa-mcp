# Consensa MCP server — example env. Copy values into your MCP client's server
# `env` block (or the shell for local dev). NEVER commit real secrets.

# Consensa endpoint base URL (no trailing slash).
CONSENSA_ENDPOINT=https://consensa-endpoint-production.up.railway.app

# "testnet" (default, recommended for trials) or "mainnet".
CONSENSA_NETWORK=testnet

# 25-word Algorand mnemonic of a DEDICATED low-balance spend wallet (the payer).
# This is the ADOPTER's wallet — Consensa never sees or holds it.
CONSENSA_MCP_PAYER_MNEMONIC=

# Optional: pin the expected payTo. If set, the server refuses to pay a 402
# whose payTo differs (defence against a spoofed/redirected endpoint).
# Mainnet Consensa app address:
# CONSENSA_EXPECTED_PAYTO=PJOXFIBKVKGYGMCW3346P5N4OATMODZYM3VQOXDAEUTIGAOGRYGTIO3NME

# Optional algod URL override (defaults to the x402-avm network default).
# CONSENSA_ALGOD_URL=

# Spend guards.
MAX_SPEND_USDC_PER_RUN=5.00
MAX_PER_CALL_USDC=0.02
MAX_CALLS_PER_MIN=10
IDEMPOTENCY_TTL_MS=300000
